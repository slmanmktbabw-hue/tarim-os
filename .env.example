# 🏰 TARIM OS V1.0 Beta - Environment Example
# انسخ هذا الملف إلى .env محلياً وعب البيانات
# في Render → Environment → Add Variable

# السيرفر
PORT=10000
NODE_ENV=production
CORS_ORIGIN=https://tarimos.org

# 👁️ عين الذكاء الاصطناعي - Gemini (اختياري - يشتغل Offline بدون مفتاح)
GEMINI_API_KEY=

# 💳 محفظة OKX
OKX_WALLET_PUBLIC=0x53...c0af6
# المفتاح الخاص مشفر - لا تحط المفتاح الأصلي هنا أبداً!
OKX_ENCRYPTED_PRIVATE=

# 🔐 أمان - غيره في الإنتاج بكلام طويل جداً 64 حرف
JWT_SECRET=Tarim_OS_V1_Beta_King_AL_2025_Change_This_To_64_Char_Long_Random_String_Secure!

# 📦 قاعدة بيانات (مستقبلاً - حالياً يشتغل بذاكرة مؤقتة)
MONGO_URI=

# 🗺️ خرائط (اختياري)
MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# TARIM OS V1.0 Beta - Environment Example
# انسخ هذا الملف الى .env في جهازك وعب البيانات

PORT=3000
CORS_ORIGIN=https://tarimos.org

# مفتاح Gemini لعين الذكاء (اختياري - يشتغل بدون مفتاح في وضع Offline)
GEMINI_API_KEY=

# محفظة OKX - العنوان العام فقط
OKX_WALLET_PUBLIC=0x53...c0af6

# مفتاح JWT سري - غيره بكلام طويل
JWT_SECRET=Tarim_OS_V1_Beta_Secret_2025_Change_This_Long_String_32_Char

# قاعدة بيانات (مستقبلاً)
MONGO_URI=

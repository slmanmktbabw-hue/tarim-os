# ==============================================================================
# TARIM OS V7.4 - HARDENED SECURE TEMPLATE
# القاعدة الذهبية: لا ترفع هذا الملف أبداً إلى GitHub. ارفع .env.example فقط
# ==============================================================================

# 1. البيئة - يجب أن تكون production لمنع تسريب الأخطاء
NODE_ENV=production

# 2. المنفذ
PORT=10000

# 3. مفاتيح التشفير - الحل النهائي للثغرة الأخطر
# لا تضع القيمة هنا مباشرة في السيرفر الحقيقي، استخدم متغيرات السيرفر
# في Render / Railway / Docker Secrets
JWT_SECRET=
# يتم توليده بـ: openssl rand -base64 64
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECRET=
# يتم توليده بـ: openssl rand -base64 32

# مفتاح تشفير عام للبيانات الحساسة داخل قاعدة البيانات
APP_ENCRYPTION_KEY=
# 32 بايت بالضبط - توليد: openssl rand -hex 32

# 4. إعدادات الأمان CORS - ثغرة شائعة جداً
# احذف أي قيمة فيها * و احذف localhost نهائياً في الإنتاج
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ALLOW_CREDENTIALS=true

# 5. قاعدة البيانات - تم إغلاق ثغرة Man-in-the-Middle
DATABASE_URL=postgresql://db_user:${DB_PASSWORD}@localhost:5432/tarim_os?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificate.crt
DB_PASSWORD=

# 6. Redis - تم إغلاق ثغرة الوصول المفتوح
REDIS_URL=rediss://:${REDIS_PASSWORD}@localhost:6380/0
REDIS_PASSWORD=
REDIS_TLS=true

# 7. إعدادات الكوكيز الآمنة - هذه أهم إضافة كانت ناقصة عندك
COOKIE_NAME=__Host-tarim_token
COOKIE_SAME_SITE=Strict
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_PATH=/
COOKIE_DOMAIN=your-domain.com

# 8. الحماية من الإغراق - قللناها أكثر للأمان
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# 9. تشفير كلمات المرور
BCRYPT_SALT_ROUNDS=12

# 10. البروكسي - ثغرة خطيرة لو بقيت false خلف Cloudflare
# إذا تستخدم Cloudflare أو Nginx اجعلها 1
TRUST_PROXY=1

# 11. حماية إضافية ناقصة
HELMET_ENABLED=true
HSTS_MAX_AGE=63072000
X_CONTENT_TYPE_OPTIONS=nosniff

# 12. تسجيل الدخول والمراقبة
LOG_LEVEL=warn
ENABLE_REQUEST_LOGGING=false

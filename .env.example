# ==============================================================================
# TARIM OS V7.3.1 - ENVIRONMENT TEMPLATE
# ملاحظة: هذا الملف مجرد مثال. لا تضع فيه كلمات السر الحقيقية.
# قم بإنشاء ملف باسم .env وانسخ هذه القيم إليه مع تعديلها.
# ==============================================================================

# البيئة (استخدم development للتطوير أو production للتشغيل الفعلي)
NODE_ENV=development

# المنفذ الذي سيعمل عليه التطبيق
PORT=10000

# مفتاح تشفير JWT (يجب أن يكون طويلاً وعشوائياً - لا تتركه كما هو في الإنتاج)
JWT_SECRET=your_super_secret_random_string_here_at_least_64_chars

# مدة صلاحية الجلسة
JWT_EXPIRES_IN=7d

# إعدادات الأمان (CORS)
ALLOWED_ORIGINS=http://localhost:10000,https://your-domain.com

# قاعدة البيانات (أمثلة)
# لـ PostgreSQL:
DATABASE_URL=postgresql://db_user:db_password@localhost:5432/tarim_os
# لـ Redis (اختياري إذا كنت تستخدم التخزين المؤقت):
REDIS_URL=redis://localhost:6379

# إعدادات الحماية من الإغراق (Rate Limiting)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================================================

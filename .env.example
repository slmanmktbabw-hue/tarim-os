# ============================================
# TARIM OS V7.3 - IMPERIAL SOVEREIGN ENV
# القلعة المحصنة - ممنوع وضع قيم حقيقية هنا
# ============================================

# --- النواة ---
NODE_ENV=production
PORT=10000

# --- الأمان السيادي - الأهم ---
# ولّد مفتاح جديد بهذا الأمر: openssl rand -base64 64
JWT_SECRET=GENERATE_A_NEW_64_CHAR_SECRET_HERE_DO_NOT_USE_DEFAULT
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- سيادة النطاق - يمنع سرقة القلعة ---
CORS_ORIGIN=https://your-castle-domain.com
ALLOWED_ORIGINS=https://your-castle-domain.com,https://tarim.app

# --- قاعدة البيانات المشفرة ---
DATABASE_URL=postgresql://user:password@host:5432/tarim_os?sslmode=require
REDIS_URL=redis://...

# --- الحماية من الإغراق ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- مفاتيح esm.unpkg المحصنة ---
# لا تضع مفاتيح API هنا، استخدم Vault

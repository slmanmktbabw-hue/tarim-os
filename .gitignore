# .gitignore - TARIM OS Sovereign Shield - PRODUCTION READY

# --- 1. درع الاعتماديات - لا ترفع المصانع ---
node_modules/
package-lock.json
yarn.lock

# --- 2. درع الأسرار السيادية - أهم قسم ---
.env
.env.local
.env.production
.env.development

# --- 3. درع بيانات الدولة والمخابرات ---
data.json
data/
database/
*.db
*.sqlite
*.sqlite3

# --- 4. درع سجلات الحروب والأخطاء ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# --- 5. درع أنظمة التشغيل الجاسوسة ---
.DS_Store
Thumbs.db
ehthumbs.db

# --- 6. درع أدوات المطورين ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- 7. درع البناء والتوزيع ---
dist/
build/
coverage/
.nyc_output/
